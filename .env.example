# Copy to .env and fill in your own keys. Never commit real keys.
# Keys the code reads (see server/plant.js and server/vision.js):

# Plant.id — identifies the plant in the photo
PLANT_ID_API_KEY=

# Manus Forge — vision model that reads visible symptoms from the photo
BUILT_IN_FORGE_API_KEY=
BUILT_IN_FORGE_API_URL=https://forge.manus.im

# Optional: override the SQLite database path (default: data/cropguide.sqlite)
# CROPGUIDE_DB_PATH=

# Optional: server port (default: 3000)
# PORT=
